local wezterm = require 'wezterm'
local act = wezterm.action

{{- $t := index .themes .theme }}
local scheme_light = {{ get $t "ghostty_light" | default $t.ghostty | quote }}
local scheme_dark = {{ get $t "ghostty_dark" | default $t.ghostty | quote }}

local appearance = wezterm.gui and wezterm.gui.get_appearance() or 'Dark'

return {
	-- Remote hosts lack wezterm terminfo; xterm-256color is the portable fallback
	term = 'xterm-256color',
	color_scheme = appearance:find 'Dark' and scheme_dark or scheme_light,
	font_size = 12,
	default_domain = 'WSL:Ubuntu',
	keys = {
		-- Ctrl+Shift+V also pastes. Ctrl+V matches other Windows apps.
		{ key = 'v', mods = 'CTRL', action = act.PasteFrom 'Clipboard' },
		-- Match the Mac by key position: Ctrl does what Option does in Ghostty, and
		-- Alt does what Cmd does. Each binding sends the bytes that Ghostty sends,
		-- so zsh and Claude Code behave the same on both machines.
		{ key = 'LeftArrow', mods = 'CTRL', action = act.SendString '\x1bb' },
		{ key = 'RightArrow', mods = 'CTRL', action = act.SendString '\x1bf' },
		{ key = 'LeftArrow', mods = 'ALT', action = act.SendString '\x01' },
		{ key = 'RightArrow', mods = 'ALT', action = act.SendString '\x05' },
		{ key = 'Backspace', mods = 'CTRL', action = act.SendString '\x1b\x7f' },
		{ key = 'Backspace', mods = 'ALT', action = act.SendString '\x15' },
		{ key = 'Enter', mods = 'CTRL', action = act.SendString '\x1b\r' },
		{ key = 'Enter', mods = 'SHIFT', action = act.SendString '\x1b\r' },
	},
}
