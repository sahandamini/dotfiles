minimumLimaVersion: 2.2.0

images:
- location: https://cloud-images.ubuntu.com/releases/resolute/release/ubuntu-26.04-server-cloudimg-amd64.img
  arch: x86_64
- location: https://cloud-images.ubuntu.com/releases/resolute/release/ubuntu-26.04-server-cloudimg-arm64.img
  arch: aarch64

# Ubuntu 26.04 NIC rename bug (LP: #2136392) blocks boot for 120s.
param:
  internal_netplanOptional: "true"
cpus: 4
memory: 16GiB
disk: 160GiB
# No host mounts: agents in the VM must not read the Mac home (keys, tokens,
# browser data). Copy files with `limactl copy` on the Mac.
mounts: []
ssh:
  localPort: 60022
provision:
# Lima gives cloud-init a new instance ID on each cold start, and cloud-init
# then replaces the SSH host keys. Keep them, so known_hosts stays valid.
- mode: data
  path: /etc/cloud/cloud.cfg.d/99-keep-ssh-host-keys.cfg
  permissions: 644
  content: |
    ssh_deletekeys: false
