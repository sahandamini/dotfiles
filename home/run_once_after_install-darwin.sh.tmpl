{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# mise owns every CLI; brew stays out of the bootstrap. Nix exists only as the
# backend for the nix: tools in ~/.config/mise/config.toml.
export PATH="$HOME/.local/bin:$PATH"

# CLT provides git and the compiler toolchain mise-built languages need.
if ! xcode-select -p &> /dev/null; then
  xcode-select --install
fi
if ! command -v git &> /dev/null; then
  echo "waiting for the Xcode CLT install (accept the dialog)" >&2
  for _ in $(seq 1 30); do
    command -v git &> /dev/null && break
    sleep 10
  done
  command -v git &> /dev/null || {
    echo "Xcode CLT is still installing. Re-run 'chezmoi apply' later." >&2
    exit 1
  }
fi

if ! command -v mise &> /dev/null; then
  curl -fsSL https://mise.run | sh
fi

# github: backends hit the GitHub API; a token avoids rate limits.
eval "$(mise activate bash)"
if ! mise where github-cli &> /dev/null; then
  mise install --quiet github-cli
fi
if ! gh auth status &> /dev/null; then
  if [ -t 0 ]; then
    gh auth login --web --git-protocol https
  else
    echo "gh is not authenticated. Run 'gh auth login --web', then 'mise install'." >&2
  fi
fi

# The Nix installer only supports the multi-user (daemon) install on macOS.
# It asks for sudo, creates the /nix APFS volume, and hooks /etc/zshrc.
nix_profile=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
if ! command -v nix &> /dev/null && [ ! -e "$nix_profile" ]; then
  sh <(curl --proto '=https' --tlsv1.2 -sSfL https://nixos.org/nix/install) --daemon --yes
fi
if [ -e "$nix_profile" ]; then
  # shellcheck source=/dev/null
  . "$nix_profile"
fi
command -v nix &> /dev/null || {
  echo "nix is not on PATH. Open a new shell and run 'mise install'." >&2
  exit 1
}

mise install --quiet
{{- end }}
