{
	"$schema": "https://opencode.ai/config.json",
	"instructions": [
		"~/AGENTS.md",
		"~/.config/opencode/instructions/workspaces.md"
	],
	"agent": {
		"explore": {
			"model": "openai/gpt-5.6-luna"
		}
	},
	"permission": {
		"*": "allow",
		"bash": {
			"*": "allow"
		}
	},
	"formatter": {
		"prettier": {
			"disabled": true
		},
		"oxfmt": {}
	},
	"lsp": {
		"typescript": {
			"command": ["tsgo", "--lsp", "--stdio"],
			"extensions": [".ts", ".tsx", ".js", ".jsx", ".mts", ".cts"]
		}
	}
}
