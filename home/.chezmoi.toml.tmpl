sourceDir = {{ printf "%s/dotfiles" .chezmoi.homeDir | quote }}

[data]
isWSL = {{ if and (eq .chezmoi.os "linux") (output "uname" "-r" | lower | contains "microsoft") }}true{{ else }}false{{ end }}
isLima = {{ if and (eq .chezmoi.os "linux") (stat "/usr/local/bin/lima-guestagent") }}true{{ else }}false{{ end }}
wslHostAddress = "192.168.88.7"
