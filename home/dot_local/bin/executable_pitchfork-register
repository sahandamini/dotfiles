#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["tomlkit>=0.13"]
# ///
"""Register or remove the Pitchfork proxy slugs of one checkout."""

import argparse
import fcntl
import hashlib
import os
import re
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from typing import Any, NoReturn

import tomlkit

MAX_LABEL = 63
HASH_LENGTH = 6
# Pitchfork reads its global config here and ignores XDG_CONFIG_HOME.
CONFIG = (
    Path(os.environ.get("PITCHFORK_CONFIG_DIR") or "~/.config/pitchfork").expanduser()
    / "config.toml"
)
# Pitchfork requires each namespace in these files to match. The script writes
# pitchfork.local.toml itself.
OTHER_PROJECT_FILES = [
    "pitchfork.toml",
    ".config/pitchfork.toml",
    ".config/pitchfork.local.toml",
]


def fail(message: str) -> NoReturn:
    sys.exit(f"pitchfork-register: {message}")


def normalize(slug: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", slug.lower()).strip("-")
    return slug[:MAX_LABEL].strip("-")


def hashed(slug: str, root: Path) -> str:
    digest = hashlib.sha256(str(root).encode()).hexdigest()[:HASH_LENGTH]
    return f"{slug[: MAX_LABEL - HASH_LENGTH - 1].strip('-')}-{digest}"


def load() -> Any:
    return (
        tomlkit.parse(CONFIG.read_text(encoding="utf-8"))
        if CONFIG.exists()
        else tomlkit.document()
    )


def write(path: Path, document: Any) -> None:
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as file:
        temporary = Path(file.name)
    try:
        temporary.write_text(tomlkit.dumps(document), encoding="utf-8")
        temporary.chmod(mode)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def resolved(directory: Any) -> Path | None:
    return Path(str(directory)).expanduser().resolve() if directory else None


def namespace_dir(config: Any, namespace: Any) -> Path | None:
    return resolved(config.get("namespaces", {}).get(str(namespace), {}).get("dir"))


def slug_dir(config: Any, entry: Any) -> Path | None:
    # Pitchfork uses a direct slug dir before the namespace dir.
    if "dir" in entry:
        return resolved(entry["dir"])
    return namespace_dir(config, entry.get("namespace"))


def variants(config: Any, name: str) -> list[str]:
    # Host names ignore case, so pitchfork refuses slugs that differ only in case.
    return [key for key in config.get("slugs", {}) if key.lower() == name]


def local_namespace(root: Path) -> Any:
    local = root / "pitchfork.local.toml"
    return (
        tomllib.loads(local.read_text(encoding="utf-8")).get("namespace")
        if local.exists()
        else None
    )


def url(config: Any, name: str) -> str:
    tld = config.get("settings", {}).get("proxy", {}).get("tld", "localhost")
    return f"https://{name}.{tld}"


def pitchfork(*args: str) -> None:
    result = subprocess.run(
        ["pitchfork", *args],
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stdout + result.stderr)
        fail(f"pitchfork {' '.join(args)} exited with status {result.returncode}")


def drop_namespace(config: Any, namespace: str) -> None:
    namespaces = config.get("namespaces", {})
    namespaces.pop(namespace, None)
    if "namespaces" in config and not namespaces:
        del config["namespaces"]


def drop_slugs(config: Any, keys: list[str]) -> None:
    slugs = config.get("slugs", {})
    for key in keys:
        slugs.pop(key, None)
    if "slugs" in config and not slugs:
        del config["slugs"]


def attached(config: Any, namespace: str) -> bool:
    # `pitchfork config add` stores config attachments in the namespace table.
    return bool(config.get("namespaces", {}).get(namespace, {}).get("config"))


def drop_stale_namespace(config: Any, namespace: str) -> None:
    slugs = config.get("slugs", {})
    drop_slugs(
        config,
        [
            key
            for key, entry in slugs.items()
            if "dir" not in entry and entry.get("namespace") == namespace
        ],
    )
    if not attached(config, namespace):
        drop_namespace(config, namespace)


def taken(config: Any, name: str, root: Path) -> bool:
    """Return True if a live entry for another directory uses the name.

    Delete each entry that points to a directory that no longer exists. If the
    name is free, also delete each case variant of it that points to the root.
    """
    own_variants = []
    for key in variants(config, name):
        entry = config.get("slugs", {}).get(key)
        if entry is None:
            continue
        directory = slug_dir(config, entry)
        if directory == root:
            if key != name:
                own_variants.append(key)
        elif directory is not None and directory.is_dir():
            return True
        else:
            drop_slugs(config, [key])
            namespace = entry.get("namespace")
            if "dir" not in entry and namespace is not None:
                drop_stale_namespace(config, str(namespace))
    if name in config.get("namespaces", {}):
        directory = namespace_dir(config, name)
        if directory != root:
            if (directory is not None and directory.is_dir()) or attached(config, name):
                return True
            drop_stale_namespace(config, name)
    drop_slugs(config, own_variants)
    return False


def registered(config: Any, name: str, root: Path, daemon: str) -> bool:
    entry = config.get("slugs", {}).get(name)
    return (
        entry is not None
        and variants(config, name) == [name]
        and "dir" not in entry
        # Pitchfork omits the daemon when it equals the slug.
        and entry.get("daemon", name) == daemon
        and namespace_dir(config, entry.get("namespace")) == root
        and local_namespace(root) == entry.get("namespace")
    )


def check_namespaces(root: Path, name: str) -> None:
    for path in (root / file for file in OTHER_PROJECT_FILES):
        if path.exists():
            namespace = tomllib.loads(path.read_text(encoding="utf-8")).get("namespace")
            if namespace is not None and namespace != name:
                fail(
                    f"{path} declares namespace {namespace!r}; "
                    "remove it or update the file"
                )


def write_local(root: Path, name: str) -> None:
    local = root / "pitchfork.local.toml"
    document = (
        tomlkit.parse(local.read_text(encoding="utf-8"))
        if local.exists()
        else tomlkit.document()
    )
    if document.get("namespace") == name:
        return
    document["namespace"] = name
    write(local, document)


# Pitchfork 2.29 marks slugs as legacy, so this setup must move when slugs go
# away.
# Slugs, not automatic nested hostnames: nested names need a certificate for
# each worktree, and each certificate publishes the branch name in Certificate
# Transparency logs.
def add(slug: str, root: Path, daemon: str) -> None:
    candidates = [slug, hashed(slug, root)]
    config = load()
    for name in candidates:
        if registered(config, name, root, daemon):
            check_namespaces(root, str(config["slugs"][name]["namespace"]))
            print(url(config, name))
            return

    before = tomlkit.dumps(config)
    name = slug
    if taken(config, slug, root):
        name = candidates[1]
        if taken(config, name, root):
            fail(f"{slug!r} and {name!r} both belong to other checkouts")
    check_namespaces(root, name)
    if tomlkit.dumps(config) != before:
        write(CONFIG, config)
    write_local(root, name)
    pitchfork(
        "proxy",
        "add",
        name,
        "--daemon",
        daemon,
        "--dir",
        str(root),
        "--namespace",
        name,
    )
    print(url(config, name))
    if name != slug:
        print(
            f"pitchfork-register: {slug!r} belongs to another checkout; "
            f"registered {name!r} instead",
            file=sys.stderr,
        )


def remove(root: Path) -> None:
    config = load()
    namespaces = [
        namespace
        for namespace, entry in config.get("namespaces", {}).items()
        if resolved(entry.get("dir")) == root
    ]
    slugs = [
        slug
        for slug, entry in config.get("slugs", {}).items()
        if slug_dir(config, entry) == root
    ]
    for slug in slugs:
        pitchfork("proxy", "remove", slug)
        print(f"Removed {url(config, slug)}")
    if not namespaces:
        return
    # Pitchfork has no command that removes a namespace. Keep a namespace with
    # config attachments from `pitchfork config add`, and one that another
    # writer moved to a different directory.
    config = load()
    for namespace in namespaces:
        entry = config.get("namespaces", {}).get(namespace, {})
        if resolved(entry.get("dir")) == root and not attached(config, namespace):
            drop_namespace(config, namespace)
    write(CONFIG, config)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Register a proxy slug and a matching daemon namespace, "
        "or remove the registrations of a checkout"
    )
    parser.add_argument("slug", nargs="?")
    parser.add_argument("--daemon", default="dev")
    parser.add_argument("--dir", type=Path, default=Path.cwd())
    parser.add_argument(
        "--remove", action="store_true", help="remove the slugs of --dir"
    )
    args = parser.parse_args()
    if args.remove:
        if args.slug is not None:
            parser.error("--remove takes no slug")
        root = args.dir.expanduser().resolve()
    else:
        if args.slug is None:
            parser.error("a slug is required")
        slug = normalize(args.slug)
        if not slug:
            parser.error(f"the slug {args.slug!r} has no letters or digits")
        root = args.dir.expanduser().resolve()
        if not root.is_dir():
            parser.error(f"{args.dir} is not a directory")
        if (root / "pitchfork.local.toml").is_symlink():
            parser.error(
                "pitchfork.local.toml must be checkout-specific, not a symlink"
            )

    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    state.mkdir(parents=True, exist_ok=True)
    # Accepted risk: `chezmoi apply` rewrites the config through
    # modify_config.toml without this lock. A lost write needs an apply during
    # a `wt switch --create`, so it is rare. A chezmoi template cannot take a
    # flock.
    with open(state / "pitchfork-register.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.remove:
            remove(root)
        else:
            add(slug, root, args.daemon)


if __name__ == "__main__":
    main()
