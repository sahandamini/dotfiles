{{- $host := includeTemplate "host-kind" (dict "os" .chezmoi.os "osrelease" (get .chezmoi.kernel "osrelease" | default "")) -}}
{{/* ~/dotfiles links to the repo; a real directory there is a checkout from
     before the move to ~/.local/share/chezmoi, so leave it alone. */ -}}
{{ $dotfiles := joinPath .chezmoi.homeDir "dotfiles" -}}
{{ $existing := lstat $dotfiles -}}
{{ if or (eq .chezmoi.workingTree $dotfiles) (and $existing (ne $existing.type "symlink")) }}
dotfiles
{{ end }}
{{ if ne $host "linux" }}
.config/caddy-lab
.config/pitchfork
.config/mise/tasks/setup-caddy
{{ end }}
{{ if ne .chezmoi.os "darwin" }}
.config/lima
.lima
{{ end }}
{{ if ne .chezmoi.os "linux" }}
.config/systemd
{{ end }}
.config/herdr/.plugins.lock
.config/herdr/herdr-client.log
.config/herdr/herdr-client.sock
.config/herdr/herdr-server.log
.config/herdr/herdr.sock
.config/herdr/release-notes.json
.config/herdr/session.json
{{ if ne .chezmoi.os "windows" }}
.config/wezterm
{{ else }}
{{/* Native Windows gets only the files that Windows programs read. WSL
     applies everything else. */ -}}
**
!AGENTS.md
!.ssh{,/**}
!.config
!.config/{opencode,wezterm}{,/**}
{{ end }}
{{/* Without age, chezmoi keeps the .age suffix in target names. */ -}}
{{ if ne (get .chezmoi.config "encryption" | default "") "age" }}
.config/caddy-lab/env{,.age}
{{ end }}
