{{- $t := index .themes .theme -}}
{{ if hasKey $t "ghostty_light" -}}
theme = light:{{ $t.ghostty_light }},dark:{{ $t.ghostty_dark }}
{{ else -}}
theme = {{ $t.ghostty | quote }}
{{ end }}
font-size = 12
mouse-hide-while-typing = true
window-decoration = true
macos-option-as-alt = true
desktop-notifications = true
# Shift+Enter sends what Option+Enter sends, so it adds a new line in the
# shell and in Claude Code.
keybind = shift+enter=text:\x1b\r
