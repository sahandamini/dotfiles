# ── Environment ───────────────────────────────────────────────
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export EDITOR='nvim'
export VISUAL='nvim'
if (( ! $+commands[infocmp] )) || [[ -z "$TERM" ]] || ! infocmp "$TERM" >/dev/null 2>&1; then
  if (( $+commands[infocmp] )) && infocmp xterm-256color >/dev/null 2>&1; then
    export TERM=xterm-256color
  else
    export TERM=dumb
  fi
fi
export OPENCODE_EXPERIMENTAL_OXFMT=1
export OLLAMA_HOST="http://127.0.0.1:11434"
export DOTFILES={{ .chezmoi.workingTree | quote }}
# Global-only mise setting for Herdr workspace copies.
export MISE_TRUSTED_CONFIG_PATHS="$HOME/.herdr/worktrees/:$HOME/.herdr/workspaces/:$HOME/.t3/worktrees/:$HOME/.t3/workspaces/"

# ── Path ──────────────────────────────────────────────────────
export PATH="$PATH:/usr/sbin:/sbin"
export PATH="$PATH:$HOME/.local/bin"
{{ if eq .chezmoi.os "linux" -}}
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
{{ end -}}

# ── Initialization ────────────────────────────────────────────
# Nix is loaded in .zprofile.
eval "$(mise activate zsh)"

# ── Aliases ───────────────────────────────────────────────────
alias lg='lazygit'
# Keep plain ls usable while eza is not installed yet (fresh machines).
if (( $+commands[eza] )); then
  alias ls='eza -1 --icons --group-directories-first'
fi
alias k='kubectl'
alias tree='erd'
alias pr="gh-dash"
alias gd='hunk diff --watch'
dotfiles() {
  case "${1:-}" in
  '') cd {{ .chezmoi.workingTree | quote }} ;;
  update)
    # Update mise first: a newer lockfile can need a newer mise.
    mise self-update -y && chezmoi update --init && mise install && mise up
    ;;
  *)
    print -u2 'usage: dotfiles [update]'
    return 2
    ;;
  esac
}
gr() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  cd "$root"
}

gw() {
  local root
  if [[ -z "${HERDR_WORKSPACE_ID:-}" ]]; then
    print 'gw: not inside a herdr pane' >&2
    return 1
  fi
  root=$(herdr workspace list |
    jq -er --arg id "$HERDR_WORKSPACE_ID" \
      '.result.workspaces[] | select(.workspace_id == $id) | .worktree.checkout_path? // empty') ||
    root=$(herdr pane list |
      jq -er --arg id "$HERDR_WORKSPACE_ID" \
        '[.result.panes[] | select(.workspace_id == $id)] |
         sort_by(.pane_id | sub(".*:"; "") | ltrimstr("p") | tonumber) |
         .[0].cwd // empty')
  [[ -n "$root" ]] || { print 'gw: workspace checkout not found' >&2; return 1 }
  cd "$root"
}

nvim()
{
    local nvim_new_dir_file="${XDG_CACHE_HOME:-$HOME/.cache}/nvim/newdir"
    mkdir -p "$(dirname "$nvim_new_dir_file")"
    rm -f "$nvim_new_dir_file"

    NVIM_NEW_DIR_FILE="$nvim_new_dir_file" command nvim "$@"

    if [ -f "$nvim_new_dir_file" ]; then
            local nvim_new_dir="$(cat "$nvim_new_dir_file")"
            rm -f "$nvim_new_dir_file" > /dev/null

            if [ -n "$nvim_new_dir" ] && [ -d "$nvim_new_dir" ]; then
                    cd "$nvim_new_dir"
            fi
    fi
}

vim()
{
    nvim "$@"
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

{{ if eq .chezmoi.os "darwin" -}}
# ── Platform: macOS ────────────────────────────────────────────
export PATH="$PATH:/Applications/Docker.app/Contents/Resources/bin/"
# lima and limactl commands without an instance name use this VM.
export LIMA_INSTANCE={{ .vm.name | quote }}
{{ end }}
{{ if .isLima -}}
# ── Platform: Lima Guest ───────────────────────────────────────
export OLLAMA_HOST="http://host.lima.internal:11434"
{{ end }}

# ── Completion ────────────────────────────────────────────────
autoload -Uz compinit
compinit

# ── FZF ───────────────────────────────────────────────────────
source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --hidden'
export FZF_COMPLETION_OPTS="--preview '~/.config/fzf/fzf-preview.sh {}' --border --info=inline"

_fzf_compgen_path() {
  fd --hidden --follow --color=never . "$1"
}

_fzf_compgen_dir() {
  fd --hidden --follow --type directory --color=never . "$1"
}

if [[ -r "$HOME/.config/fzf/fzf-tab/fzf-tab.plugin.zsh" ]]; then
  source "$HOME/.config/fzf/fzf-tab/fzf-tab.plugin.zsh"
fi

# ── Zoxide ────────────────────────────────────────────────────
eval "$(zoxide init zsh)"

# ── Worktrunk ─────────────────────────────────────────────────
eval "$(wt config shell init zsh)"

# ── Theme ─────────────────────────────────────────────────────
eval "$(oh-my-posh init zsh --strict --config ~/.config/oh-my-posh/themes/theme.toml)"

bindkey -e
KEYTIMEOUT=40
echo -ne '\e[5 q'
preexec() { echo -ne '\e[5 q'; }

{{ if .isLima -}}
# Lima BEGIN
# Make sure iptables and mount.fuse3 are available
PATH="$PATH:/usr/sbin:/sbin"
export PATH
# Lima END
{{ end -}}

# ── Vite+ ─────────────────────────────────────────────────────
# Vite+ appends this line to every shell profile that does not name the env
# file; keeping it here stops that edit. Its shims manage node, npm, pnpm,
# yarn, and bun.
{{ $vpEnv := ternary "$HOME/.vite-plus/env" "$HOME/.config/vite-plus/env" (eq .chezmoi.os "darwin") -}}
if [ -f "{{ $vpEnv }}" ]; then
  . "{{ $vpEnv }}"
fi
